# Copy this file to backend/.env and adjust as needed.
# Everything here has a working development default, so .env is optional locally.

# Signs the session cookie. MUST be set to a long random value in production.
UNIFIND_SECRET_KEY=change-me-to-a-long-random-string

# "development" or "production". In production the session cookie is marked
# Secure, which requires the site to be served over HTTPS.
UNIFIND_ENV=development

# Where uploaded item photos are written. Point this at a volume outside the
# project directory in production, or replace the upload handler with an image
# bucket (S3 / Cloudinary) and store only the returned URL in SQLite.
# UNIFIND_UPLOAD_DIR=E:/unifind-uploads

# Extra browser origins allowed to call the API, comma-separated.
# localhost:5173 and localhost:3000 are always allowed.
# UNIFIND_ALLOWED_ORIGINS=https://unifind.example.edu

# --- Email confirmation ---------------------------------------------------
# Whether a new member must confirm a six-digit code before their account works.
# Off means registering signs them straight in and no code is ever sent; the
# confirmation flow stays in the codebase either way.
# UNIFIND_REQUIRE_EMAIL_CONFIRMATION=true
#
# Everything below only applies when confirmation is switched on.
# All optional. With no SMTP host set, the six-digit confirmation code is
# printed to the backend console instead of being emailed, which is enough to
# run and demonstrate the whole flow locally.
# UNIFIND_SMTP_HOST=smtp.gmail.com
# UNIFIND_SMTP_PORT=587
# UNIFIND_SMTP_USER=unifind@uiu.ac.bd
# UNIFIND_SMTP_PASSWORD=an-app-specific-password
# UNIFIND_MAIL_FROM=UniFind <no-reply@uiu.ac.bd>
